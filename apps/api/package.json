{
  "name": "@fleet-manager/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "db:migrate": "tsx db/migrate.ts",
    "db:status": "tsx db/migrate.ts --status",
    "db:reset": "tsx db/reset.ts",
    "db:seed": "tsx db/seed.ts",
    "provisionar": "tsx scripts/provisionar-empresa.ts",
    "provisionar-super-admin": "tsx scripts/provisionar-super-admin.ts",
    "carga:workload": "tsx carga/workload.ts"
  },
  "dependencies": {
    "@fleet-manager/shared": "*",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
