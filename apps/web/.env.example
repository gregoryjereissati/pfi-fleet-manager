# URL da API REST do Fleet Manager.
# Em desenvolvimento, aponta para o backend local.
# Em producao com frontend e API no mesmo dominio (projeto unico na Vercel),
# NAO defina esta variavel: as chamadas passam a usar caminho relativo.
VITE_API_URL=http://localhost:3000

# Projeto Supabase — autenticacao e Storage de arquivos
# Painel do Supabase > Project Settings > API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>
