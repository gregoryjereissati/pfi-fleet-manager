# ---------------------------------------------------------------------------
# Backend (apps/api/.env)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Conexao com o PostgreSQL do Supabase
# Painel do Supabase > Project Settings > Database > Connection string
# DATABASE_URL usa o pooler (porta 6543) — usado pela aplicacao em runtime
# DIRECT_URL usa a conexao direta (porta 5432) — usado pelas migrations do Prisma
DATABASE_URL="postgresql://postgres.<project-ref>:<SENHA>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<SENHA>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo usado para assinar os JWT da aplicacao (minimo 32 caracteres)
# Gere com: openssl rand -base64 48
JWT_SECRET=<segredo-aleatorio-com-pelo-menos-32-caracteres>

# Origens permitidas pelo CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (apps/web/.env) — ver apps/web/.env.example
# ---------------------------------------------------------------------------
