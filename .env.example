# ---------------------------------------------------------------------------
# Backend (apps/api/.env)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Conexao com o PostgreSQL do Supabase
# Painel do Supabase > Project Settings > Database > Connection string
# DATABASE_URL usa o pooler (porta 6543) — usado pela aplicacao em runtime
# DIRECT_URL usa a conexao direta (porta 5432) — usado pelas migrations do Prisma
DATABASE_URL="postgresql://postgres.<project-ref>:<SENHA>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<SENHA>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# URL do projeto Supabase, sem barra no final.
# Usada para localizar o JWKS e validar os tokens emitidos pelo Supabase Auth.
# A API nao precisa de nenhuma chave secreta do Supabase: a verificacao dos
# tokens e feita com a chave publica publicada pelo proprio projeto.
SUPABASE_URL=https://<project-ref>.supabase.co

# Chave service_role do projeto Supabase.
# Painel do Supabase > Project Settings > API Keys > service_role
# Necessaria EM TEMPO DE EXECUCAO: e com ela que a API assina as URLs de
# leitura e de envio dos anexos, junto ao Storage. O navegador nao fala mais
# com o Storage. Cadastre-a tambem nas variaveis de ambiente da Vercel.
# E uma chave SECRETA: nunca use o prefixo VITE_ nem a coloque no frontend.
SUPABASE_SERVICE_ROLE_KEY=<chave-service-role>

# Origens autorizadas pelo CORS, separadas por virgula.
# Em desenvolvimento pode ficar vazio: localhost e aceito automaticamente.
# Em producao, informe o dominio do frontend publicado. Ex.:
#   CORS_ORIGINS=https://fleet-manager.vercel.app
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Frontend (apps/web/.env) — ver apps/web/.env.example
# ---------------------------------------------------------------------------
